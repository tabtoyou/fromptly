{
  "manifest_version": 3,
  "name": "Fromptly",
  "version": "1.0.0",
  "description": "Real-time prompt grammar coach for AI IDEs like Lovable and Gemini.",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://aistudio.google.com/*",
    "https://notion.so/*",
    "https://*.atlassian.net/*",
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["vague-phrases.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
